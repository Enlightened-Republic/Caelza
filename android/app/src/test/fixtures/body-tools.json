        },
        "name": {
          "type": "string"
        },
        "notes": {
          "default": "",
          "type": "string"
        },
        "token": {
          "description": "the remote's bearer token (its run/http-token)",
          "type": "string"
        },
        "url": {
          "description": "http://<tailscale-ip>:42618/mcp",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "token"
      ],
      "type": "object"
    },
    "name": "device_join"
  },
