    "stroke": 0.034,
    "gradient_direction": "vertical",
    "c_polygon": [[0.62, 0.345], [0.455, 0.345], [0.405, 0.395], [0.405, 0.605], [0.455, 0.655], [0.60, 0.655], [0.60, 0.585], [0.485, 0.585], [0.475, 0.575], [0.475, 0.425], [0.485, 0.415], [0.62, 0.415]],
    "c_outline": 0.020,
    "c_inner_gap": 0.007,
    "stars": {
      "gamma": { "pos": [0.533, 0.21], "r": 0.036, "mag": 4.55, "where": "the head of the bolt" },
      "beta":  { "pos": [0.655, 0.46], "r": 0.026, "mag": 5.05, "where": "the right notch" },
      "alpha": { "pos": [0.345, 0.50], "r": 0.042, "mag": 4.45, "where": "the left notch, the brightest star" },
      "delta": { "pos": [0.41, 0.86],  "r": 0.023, "mag": 5.07, "where": "the tip" }
    },
    "constellation": [["delta", "alpha"], ["alpha", "beta"], ["beta", "gamma"]],
    "minor_stars": [[0.505, 0.30, 0.010], [0.44, 0.74, 0.009], [0.60, 0.33, 0.008]],
    "note": "The sky figure delta–alpha–beta–gamma is a hook (the chisel). The bolt takes the liberty of a zigzag and a mirror, as star globes do; the star order and relative brightness are kept."
  }
