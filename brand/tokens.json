  "mark": {
    "description": "Caelum, the constellation, drawn as a lightning bolt. Its four main stars (delta, alpha, beta, gamma Caeli, which form a bent line in the sky) sit at the bolt's four turning points and the constellation line is the bolt's zigzag spine. The bolt is a neon outline in the cyan→violet→purple gradient with a soft glow. An optional chamfered C (mark.c.enabled, or make_assets.py --with-c) can sit in the waist.",
    "bolt": [[0.60, 0.03], [0.27, 0.64], [0.46, 0.64], [0.37, 0.97], [0.73, 0.36], [0.54, 0.36]],
    "stroke": 0.034,
    "gradient_direction": "vertical",
    "c": {
      "enabled": false,
      "polygon": [[0.58, 0.37], [0.445, 0.37], [0.40, 0.415], [0.40, 0.585], [0.445, 0.63], [0.58, 0.63], [0.58, 0.565], [0.475, 0.565], [0.465, 0.555], [0.465, 0.445], [0.475, 0.435], [0.58, 0.435]],
      "shear": 0.54,
      "outline": 0.020,
      "inner_gap": 0.007,
      "note": "Symmetric: top and bottom arms are the same length. `shear` leans the letter to match the bolt's edges (dx per unit of height, applied about y = 0.5), so its verticals run parallel to the bolt and it sits inside the waist."
    },
    "stars": {
      "gamma": { "pos": [0.548, 0.19], "r": 0.036, "mag": 4.55, "where": "the head of the bolt" },
      "beta":  { "pos": [0.68, 0.40],  "r": 0.026, "mag": 5.05, "where": "the right notch" },
      "alpha": { "pos": [0.33, 0.625], "r": 0.042, "mag": 4.45, "where": "the left notch, the brightest star" },
      "delta": { "pos": [0.418, 0.86], "r": 0.023, "mag": 5.07, "where": "the tip" }
    },
    "constellation": [["delta", "alpha"], ["alpha", "beta"], ["beta", "gamma"]],
    "minor_stars": [[0.505, 0.30, 0.010], [0.44, 0.76, 0.009], [0.63, 0.50, 0.008]],
    "note": "The sky figure delta–alpha–beta–gamma is a hook (the chisel). The bolt takes the liberty of a zigzag and a mirror, as star globes do; the star order and relative brightness are kept."
  }
