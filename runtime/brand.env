# Brand variables for the Caelza runtime build. Sourced by build.sh.
# Edit these when the public site / org changes; the rename map carries the
# literal URL substitutions, these feed the fork NOTICE and build id.

CAELZA_PRODUCT="Caelza"
CAELZA_BIN="caelza"
CAELZA_ORG="Enlightened Republic"          # the umbrella company; Caelza is presented by it
CAELZA_ORG_TM="ENLIGHTENED REPUBLIC™"
CAELZA_ORG_SLUG="Enlightened-Republic"
CAELZA_SITE="https://www.enlightenedrepublic.tech"   # Build Lab (products, services)
CAELZA_LAB="https://enlightenedrepublic.online"      # the Republic itself
CAELZA_REPO="https://github.com/Enlightened-Republic/caelza"
CAELZA_CONFIG_DIR="~/.caelza"
