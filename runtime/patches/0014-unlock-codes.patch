+/** A priced pack's unlock code to the Runtime, which checks it and answers with the wardrobe, the pack now in it. */
+export function unlockPack(code: string): Promise<Wardrobe> {
+  return apiFetch<Wardrobe>("/api/looks/wardrobe/unlock", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ code }),
+  });
+}
