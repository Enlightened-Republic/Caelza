         )
         .route("/api/mind/digest", get(api_mind::handle_mind_digest))
+        // One Mind for every device: share this device's Mind (its address and
+        // a join code) or probe another device's before joining it.
+        .route(
+            "/api/mind/share",
+            get(api_mind_share::handle_share_get)
+                .post(api_mind_share::handle_share_post)
+                .delete(api_mind_share::handle_share_delete),
+        )
+        .route("/api/mind/probe", post(api_mind_share::handle_probe))
         // The Body (caelza-body over MCP) for the dashboard's Bodies page;
