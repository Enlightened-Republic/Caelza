+// ── Looks (Caelza, vision M8): the agents' pixel characters and the wardrobe ──
+
+export interface LookResponse {
+  alias: string;
+  /** null until a look was saved: the dashboard deals the default. */
+  look: Look | null;
+}
+
+export function getLook(alias: string): Promise<LookResponse> {
+  return apiFetch<LookResponse>(`/api/looks/${encodeURIComponent(alias)}`);
+}
+
+export function putLook(alias: string, look: Look): Promise<LookResponse> {
+  return apiFetch<LookResponse>(`/api/looks/${encodeURIComponent(alias)}`, {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(look),
+  });
+}
+
+export function deleteLook(alias: string): Promise<LookResponse> {
+  return apiFetch<LookResponse>(`/api/looks/${encodeURIComponent(alias)}`, { method: "DELETE" });
+}
+
+export function getWardrobe(): Promise<Wardrobe> {
+  return apiFetch<Wardrobe>("/api/looks/wardrobe");
+}
+
+export function putWardrobe(wardrobe: Wardrobe): Promise<Wardrobe> {
+  return apiFetch<Wardrobe>("/api/looks/wardrobe", {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(wardrobe),
+  });
+}
