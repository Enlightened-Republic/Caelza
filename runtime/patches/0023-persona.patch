+// ── Persona (the agent's own hand on its look and its identity) ──
+
+/// Persona settings (`[persona]` section).
+///
+/// Caelza's agents are someones: each has a name, a pixel look and an
+/// IDENTITY.md / SOUL.md the Runtime reads into every prompt. `free` is the
+/// owner's one yes: with it on, the `look` and `identity` tools act without
+/// asking, so the agent dresses itself and shapes its own files. The tools read
+/// it from the config file at each call, so the Looks page's switch reaches the
+/// agent with its next turn.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, Configurable)]
+#[cfg_attr(feature = "schema-export", derive(schemars::JsonSchema))]
+#[prefix = "persona"]
+#[serde(default)]
+pub struct PersonaConfig {
+    /// Let the agent change its own look, IDENTITY.md and SOUL.md without
+    /// asking (the Looks page's "Let it be itself"). Default: `false`.
+    pub free: bool,
+}
