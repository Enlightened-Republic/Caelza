+/// One more resident of Ether Hollow (`[ether_hollow.residents.<alias>]`):
+/// the agent is the key, so several agents can live in the town, each with
+/// its own name, key and spending switch.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, Configurable)]
+#[cfg_attr(feature = "schema-export", derive(schemars::JsonSchema))]
+#[prefix = "ether_hollow.residents"]
+#[serde(default)]
+pub struct EtherHollowResidentConfig {
+    /// The resident's name in town.
+    pub name: String,
+    /// The resident key `register` returned (stored encrypted when secrets.encrypt = true).
+    #[secret]
+    #[credential_class = "encrypted_secret"]
+    #[cfg_attr(feature = "schema-export", schemars(extend("x-secret" = true)))]
+    pub key: Option<String>,
+    /// Let this agent spend RC (`buy`, `rent`, `rent_pay`). Default: `false`.
+    pub spend: bool,
+}
+
+/// A resident as the Runtime and the gateway see it: which agent, its name,
+/// its key when it is registered, its spending switch, and where its settings
+/// live (`/ether_hollow` for the first resident, `/ether_hollow/residents/<alias>`
+/// for the others), as a JSON pointer for the config API's writes.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EtherHollowResident {
+    pub agent: String,
+    pub name: String,
+    pub key: Option<String>,
+    pub spend: bool,
+    pub path: String,
+}
+
+impl EtherHollowConfig {
+    fn first_resident(&self) -> EtherHollowResident {
+        EtherHollowResident {
+            agent: self.agent.trim().to_string(),
+            name: self.name.clone(),
+            key: self.key.as_deref().map(str::trim).filter(|k| !k.is_empty()).map(str::to_string),
+            spend: self.spend,
+            path: "/ether_hollow".to_string(),
+        }
+    }
+
+    fn listed_resident(&self, alias: &str, cfg: &EtherHollowResidentConfig) -> EtherHollowResident {
+        EtherHollowResident {
+            agent: alias.to_string(),
+            name: cfg.name.clone(),
+            key: cfg.key.as_deref().map(str::trim).filter(|k| !k.is_empty()).map(str::to_string),
+            spend: cfg.spend,
+            path: format!("/ether_hollow/residents/{alias}"),
+        }
+    }
+
+    /// The resident `alias` is, if it is one: its `residents` entry, else the
+    /// first resident (the top-level settings) when `alias` is `agent`.
+    pub fn resident(&self, alias: &str) -> Option<EtherHollowResident> {
+        let alias = alias.trim();
+        if let Some(cfg) = self.residents.get(alias) {
+            return Some(self.listed_resident(alias, cfg));
+        }
+        if !alias.is_empty() && alias == self.agent.trim() {
+            return Some(self.first_resident());
+        }
+        None
+    }
+
+    /// Every resident: the first one first (unless a `residents` entry has its
+    /// alias), then the rest by alias. One without a key is a resident-to-be
+    /// the dashboard can register.
+    pub fn residents(&self) -> Vec<EtherHollowResident> {
+        let mut out = Vec::new();
+        let first = self.first_resident();
+        if !first.agent.is_empty() && !self.residents.contains_key(&first.agent) {
+            out.push(first);
+        }
+        let mut aliases: Vec<&String> = self.residents.keys().collect();
+        aliases.sort();
+        for alias in aliases {
+            out.push(self.listed_resident(alias, &self.residents[alias]));
+        }
+        out
+    }
+}
