+    // ── the backend's standing context ────────────────────────────────────
+
+    const STANDING: &str = "[BRAIN: identity]\n- **Name:** Cael\n\n[BRAIN: now]\nthe first run on the REVVL";
+
+    #[tokio::test]
+    async fn the_standing_context_opens_the_block_even_when_nothing_is_recalled() {
+        let mem = FixtureMemory::with(vec![]).standing(STANDING);
+        let observer = RecordingObserver::default();
+
+        let context = render_memory_context(
+            &mem,
+            &observer,
+            "how is the phone doing?",
+            &[Some("telegram:42")],
+            &MemoryInjectConfig::default(),
+            false,
+            TurnMeta {
+                parent_agent_alias: None,
+                agent_alias: Some("cael"),
+                turn_id: "t",
+                channel_name: "telegram",
+            },
+        )
+        .await;
+
+        assert_eq!(
+            context,
+            format!("{MEMORY_CONTEXT_OPEN}\n{STANDING}\n{MEMORY_CONTEXT_CLOSE}\n\n")
+        );
+        // The backend was told whose turn it is, which conversation, the message,
+        // and that a conversational turn carries the owner's own words.
+        assert_eq!(
+            mem.standing_calls.lock().as_slice(),
+            &[(
+                Some("cael".to_string()),
+                Some("telegram:42".to_string()),
+                "how is the phone doing?".to_string(),
+                true
+            )]
+        );
+        // The observer's recall event is unchanged by it.
+        assert_eq!(observer.recalls.lock().as_slice(), &[(0, true)]);
+    }
