         .route("/api/memory", post(api::handle_api_memory_store))
         .route("/api/memory/{key}", delete(api::handle_api_memory_delete))
+        // The Mind (xanima brain service) for the dashboard's Memory page;
+        // the gateway holds the tokens and proxies the brain tools.
+        .route("/api/mind/status", get(api_mind::handle_mind_status))
+        .route("/api/mind/recall", get(api_mind::handle_mind_recall))
+        .route("/api/mind/forget", post(api_mind::handle_mind_forget))
+        .route(
+            "/api/mind/review",
+            get(api_mind::handle_mind_review_list).post(api_mind::handle_mind_review_decide),
+        )
         .route("/api/cost", get(api::handle_api_cost))
         .route("/api/cli-tools", get(api::handle_api_cli_tools))
         .route("/api/channels", get(api::handle_api_channels))
