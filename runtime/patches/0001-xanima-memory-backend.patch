+/// xanima brain service (`[storage.xanima.<alias>]`): Caelza's Mind.
+///
+/// One `xanima-server` process owns the shared brain and one private brain per
+/// agent and serves them over MCP Streamable HTTP with per-agent bearer
+/// tokens. The `xanima` memory backend talks to it natively, so recall runs on
+/// every turn without a tool call and every agent reaches its own brain with
+/// its own token.
+#[derive(Debug, Clone, Serialize, Deserialize, Configurable)]
+#[cfg_attr(feature = "schema-export", derive(schemars::JsonSchema))]
+#[prefix = "storage_xanima"]
+#[serde(default)]
+pub struct XanimaStorageConfig {
+    /// Service base URL. Default `http://127.0.0.1:18790`, the service's
+    /// loopback listener; use its tailnet address for a brain on another host.
+    pub url: String,
+    /// One bearer token used for every agent. Prefer `token_file`, which keeps
+    /// one token per agent so the service can tell the agents apart.
+    #[secret]
+    #[credential_class = "encrypted_secret"]
+    #[cfg_attr(feature = "schema-export", schemars(extend("x-secret" = true)))]
+    pub token: Option<String>,
+    /// Path of the token file; `{agent}` is replaced by the agent alias.
+    /// Default `~/.xanima/tokens/{agent}.token`. Mint one per agent with
+    /// `xanima-server token mint --agent <alias> --scopes read,write`.
+    pub token_file: Option<String>,
+    /// Agent alias used by operations that carry no agent (the operator CLI,
+    /// the install-wide memory handle). Default `main`.
+    pub agent: String,
+    /// Which brains recall searches: `all` (the agent's private brain plus the
+    /// shared brain, default), `private`, or `shared`.
+    pub scope: String,
+    /// Request timeout in seconds (default 20).
+    pub timeout_secs: u64,
+}
+
+impl Default for XanimaStorageConfig {
+    fn default() -> Self {
+        Self {
+            url: default_xanima_url(),
+            token: None,
+            token_file: None,
+            agent: "main".into(),
+            scope: "all".into(),
+            timeout_secs: 20,
+        }
+    }
+}
+
+fn default_xanima_url() -> String {
+    "http://127.0.0.1:18790".into()
+}
+
 fn default_storage_schema() -> String {
     "public".into()
 }
