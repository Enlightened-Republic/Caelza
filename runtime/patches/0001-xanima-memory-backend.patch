+    #[test]
+    fn factory_xanima_without_storage_entry_uses_loopback_defaults() {
+        // A bare `backend = "xanima"` resolves to ActiveStorage::None; the
+        // factory falls back to the service's loopback URL and the token-file
+        // convention instead of refusing. Nothing is contacted at build time.
+        let tmp = TempDir::new().unwrap();
+        let cfg = MemoryConfig {
+            backend: "xanima".into(),
+            hygiene_enabled: false,
+            ..MemoryConfig::default()
+        };
+        let mem = create_memory(&cfg, tmp.path(), None).unwrap();
+        assert_eq!(mem.name(), "xanima");
+    }
+
+    #[test]
+    fn factory_xanima_reads_the_storage_entry() {
+        let tmp = TempDir::new().unwrap();
+        let mut config = Config::default();
+        config.memory.backend = "xanima.hub".into();
+        config.memory.hygiene_enabled = false;
+        config.data_dir = tmp.path().to_path_buf();
+        let mut entry = caelza_config::schema::XanimaStorageConfig::default();
+        entry.url = "http://hub.local:18790/".into();
+        entry.scope = "private".into();
+        entry.agent = "clamps".into();
+        config.storage.xanima.insert("hub".into(), entry);
+        let settings = match config.resolve_active_storage() {
+            caelza_config::schema::ActiveStorage::Xanima(x) => XanimaSettings::from_storage(x).unwrap(),
+            other => panic!("expected xanima storage, got {other:?}"),
+        };
+        assert_eq!(settings.url, "http://hub.local:18790");
+        assert_eq!(settings.scope, "private");
+        assert_eq!(settings.agent, "clamps");
+        let mem = create_memory_from_config(&config, None).unwrap();
+        assert_eq!(mem.name(), "xanima");
+
+        let mut bad = config.clone();
+        bad.storage.xanima.get_mut("hub").unwrap().scope = "nope".into();
+        assert!(create_memory_from_config(&bad, None).is_err());
+    }
+
+    #[test]
+    fn factory_xanima_parses_the_mind_example_wiring() {
+        // The block mind/caelza-mind.example.toml ships, through the real
+        // config loader: `[storage.xanima.default]` deserializes and resolves.
+        let tmp = TempDir::new().unwrap();
+        let text = r#"
+schema_version = 3
+
+[memory]
+backend = "xanima"
+
+[storage.xanima.default]
+url = "http://127.0.0.1:18790"
+token_file = "~/.xanima/tokens/{agent}.token"
+agent = "main"
+scope = "all"
+timeout_secs = 20
+"#;
+        let mut config: Config = toml::from_str(text).expect("the mind example wiring parses");
+        config.data_dir = tmp.path().to_path_buf();
+        config.memory.hygiene_enabled = false;
+        match config.resolve_active_storage() {
+            caelza_config::schema::ActiveStorage::Xanima(x) => {
+                assert_eq!(x.url, "http://127.0.0.1:18790");
+                assert_eq!(x.token_file.as_deref(), Some("~/.xanima/tokens/{agent}.token"));
+                assert_eq!(x.agent, "main");
+                assert_eq!(x.timeout_secs, 20);
+                assert!(x.token.is_none());
+            }
+            other => panic!("expected xanima storage, got {other:?}"),
+        }
+        let mem = create_memory_from_config(&config, None).unwrap();
+        assert_eq!(mem.name(), "xanima");
+    }
