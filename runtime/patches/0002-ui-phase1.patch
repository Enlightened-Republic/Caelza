+
+/// The dashboard's service worker (`web/public/sw.js`) is served under `/_app/`
+/// but must control the SPA root (the installed app, the offline shell).
+/// Browsers allow a scope above the script's directory only when the script is
+/// served with `Service-Worker-Allowed` naming it.
+fn allow_root_scope(mut response: Response, path: &str, path_prefix: &str) -> Response {
+    if path == "sw.js"
+        && let Ok(scope) = header::HeaderValue::from_str(&format!("{path_prefix}/"))
+    {
+        response.headers_mut().insert(
+            header::HeaderName::from_static("service-worker-allowed"),
+            scope,
+        );
+    }
+    response
 }
 
