+pub mod api_mind_install;
 pub mod api_mind_share;
 pub mod api_oidc;
 pub mod api_pairing;
@@ -2371,6 +2372,11 @@
                 .delete(api_mind_share::handle_share_delete),
         )
         .route("/api/mind/probe", post(api_mind_share::handle_probe))
+        // The Mind turned on from the Memory page: the install job and its state.
+        .route(
+            "/api/mind/install",
+            get(api_mind_install::handle_install_get).post(api_mind_install::handle_install_post),
+        )
         // The Body (caelza-body over MCP) for the dashboard's Bodies page;
         // the gateway owns the connection and makes the tool calls.
         .route("/api/bodies/status", get(api_bodies::handle_bodies_status))
