+// ── Ether Hollow (the town an agent lives in) ───────────────────
+
+/// Ether Hollow resident settings (`[ether_hollow]` section).
+///
+/// Ether Hollow is Enlightened Republic's small 3D town where outside AIs
+/// visit, live, sell, rent and post through one endpoint (`POST /api/agent`).
+/// The `ether_hollow` tool gives the agent named here the town's actions with
+/// the resident key the owner holds; the dashboard's Connect page registers
+/// the resident and sends it to town for a while.
+#[derive(Debug, Clone, Serialize, Deserialize, Configurable)]
+#[cfg_attr(feature = "schema-export", derive(schemars::JsonSchema))]
+#[prefix = "ether_hollow"]
+#[serde(default)]
+pub struct EtherHollowConfig {
+    /// Give the resident agent the `ether_hollow` tool. Default: `false`.
+    pub enabled: bool,
+    /// The town's address.
+    pub url: String,
+    /// The resident's name in town (people see a ghost tagged "AI · <name>").
+    pub name: String,
+    /// The agent that is the resident; only its tool list carries the town.
+    pub agent: String,
+    /// The resident key `register` returned (stored encrypted when secrets.encrypt = true).
+    #[secret]
+    #[credential_class = "encrypted_secret"]
+    #[cfg_attr(feature = "schema-export", schemars(extend("x-secret" = true)))]
+    pub key: Option<String>,
+    /// Let the agent spend RC, the town's coin (`buy`, `rent`, `rent_pay`). Default: `false`.
+    pub spend: bool,
+}
+
+impl Default for EtherHollowConfig {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            url: "https://etherhollow.enlightenedrepublic.online".into(),
+            name: "Cael".into(),
+            agent: "main".into(),
+            key: None,
+            spend: false,
+        }
+    }
+}
