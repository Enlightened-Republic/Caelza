+
+// ── Connect (Caelza): the skills the Runtime carries, put on disk for an agent ──
+
+export interface ConnectSkills {
+  agent: string;
+  dir: string;
+  skills: Record<string, { installed: boolean; path: string }>;
+}
+
+export function getConnectSkills(agent: string): Promise<ConnectSkills> {
+  return apiFetch<ConnectSkills>(`/api/connect/skills?agent=${encodeURIComponent(agent)}`);
+}
+
+export interface ConnectSkillInstalled {
+  agent: string;
+  name: string;
+  path: string;
+  installed: boolean;
+}
+
+export function installConnectSkill(name: string, agent: string): Promise<ConnectSkillInstalled> {
+  return apiFetch<ConnectSkillInstalled>(`/api/connect/skills/${encodeURIComponent(name)}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ agent }),
+  });
+}
